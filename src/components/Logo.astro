---
/* Redibujo provisional del logotipo (casa, sol y figura). Reemplazar por el vector oficial. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" focusable="false">
    <circle class="logo__sun" cx="37" cy="10" r="6"></circle>
    <path
      class="logo__house"
      d="M6 23 22 8l16 15v17a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z"
      fill="none"
      stroke-width="3.2"
      stroke-linejoin="round"></path>
    <circle class="logo__head" cx="22" cy="22.500" r="3.200"></circle>
    <path
      class="logo__body"
      d="M14.500 24.500 22 30l7.500-5.500M22 30v7"
      fill="none"
      stroke-width="3.200"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Salud en Casa <span>Médicos</span></span>
    <span class="logo__sub">Servicios asistenciales domiciliarios</span>
  </span>
</span>
