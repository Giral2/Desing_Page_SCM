---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <img class="logo__mark" src="/logo.png" alt="" width="640" height="536" />
  <span class="logo__text">
    <span class="logo__name">Salud en Casa <span>Médicos</span></span>
    <span class="logo__sub">Servicios asistenciales domiciliarios</span>
  </span>
</span>
